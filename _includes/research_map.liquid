{%- comment -%}
  Clickable research map for _pages/research.md.
  research_map.svg (desktop) and research_cards.html (phones) are generated by
  bin/make_research_map.py (--style glow / --style cards). Every node carries
  data-topic="<id>"; the script below opens the matching
  <section class="topic" id="<id>"> on the page. With JavaScript off, all
  sections stay visible.
{%- endcomment -%}
<div class="rmap-wrap rmap-desktop">
  {% include research_map.svg %}
</div>
<div class="rmap-wrap rmap-mobile">
  {% include research_cards.html %}
</div>
<p class="rmap-hint">
  Click a topic to read more, or <a href="#" data-topics-all>show all</a>.
</p>

<script>
  (function () {
    // The sections come after this script in the page, so wait for the DOM.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    function init() {
    var maps = Array.prototype.slice.call(document.querySelectorAll('.rmap'));
    var topics = Array.prototype.slice.call(document.querySelectorAll('section.topic'));
    if (!maps.length || !topics.length) return;
    var article = topics[0].parentNode;
    article.classList.add('js-topics');

    function setActive(id) {
      maps.forEach(function (map) {
        map.querySelectorAll('[data-topic]').forEach(function (n) {
          n.classList.toggle('is-active', n.getAttribute('data-topic') === id);
        });
      });
    }

    function openTopic(id, scroll) {
      topics.forEach(function (t) {
        var on = t.id === id;
        t.classList.toggle('is-open', on);
        t.querySelector('h2').setAttribute('aria-expanded', on ? 'true' : 'false');
      });
      setActive(id);
      if (scroll) {
        var el = document.getElementById(id);
        if (el) {
          var y = el.getBoundingClientRect().top + window.pageYOffset - 72;
          window.scrollTo({ top: y, behavior: 'smooth' });
        }
      }
    }

    function closeAll() {
      topics.forEach(function (t) {
        t.classList.remove('is-open');
        t.querySelector('h2').setAttribute('aria-expanded', 'false');
      });
      setActive(null);
    }

    document.querySelectorAll('.rmap .rmap-node').forEach(function (n) {
      n.addEventListener('click', function (e) {
        e.preventDefault();
        var id = n.getAttribute('data-topic');
        openTopic(id, true);
        if (history.replaceState) history.replaceState(null, '', '#' + id);
      });
    });

    topics.forEach(function (t) {
      var h = t.querySelector('h2');
      h.setAttribute('tabindex', '0');
      h.setAttribute('role', 'button');
      h.setAttribute('aria-expanded', 'false');
      h.addEventListener('click', function () {
        if (t.classList.contains('is-open')) {
          closeAll();
        } else {
          openTopic(t.id, false);
          if (history.replaceState) history.replaceState(null, '', '#' + t.id);
        }
      });
      h.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          h.click();
        }
      });
    });

    var all = document.querySelector('[data-topics-all]');
    if (all) {
      all.addEventListener('click', function (e) {
        e.preventDefault();
        var anyClosed = topics.some(function (t) { return !t.classList.contains('is-open'); });
        topics.forEach(function (t) {
          t.classList.toggle('is-open', anyClosed);
          t.querySelector('h2').setAttribute('aria-expanded', anyClosed ? 'true' : 'false');
        });
        setActive(null);
        all.textContent = anyClosed ? 'collapse all' : 'show all';
      });
    }

    var hash = location.hash.replace('#', '');
    if (hash && document.getElementById(hash) && document.getElementById(hash).classList.contains('topic')) {
      openTopic(hash, true);
    }
    }
  })();
</script>
